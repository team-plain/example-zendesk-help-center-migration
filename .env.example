# Plain machine-user API key. Needs the helpCenter:edit permission.
# Required for a real run. Not used when you pass --dry-run.
PLAIN_API_KEY=

# Existing Plain help center to write into (hc_...). The script does not create one.
PLAIN_HELP_CENTER_ID=

# Optional. Defaults to the public Plain API.
# PLAIN_API_URL=https://core-api.uk.plain.com/graphql/v1

# The subdomain in https://{subdomain}.zendesk.com
ZENDESK_SUBDOMAIN=

# Leave both unset to read a public help center with no authentication.
# Set both to read drafts and restricted articles (email/token basic auth).
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Translation locale to import. Default: en-us
ZENDESK_LOCALE=en-us

# Optional. Comma-separated Zendesk category ids. Omit to import every category.
# ZENDESK_CATEGORY_IDS=123,456

# Local Zendesk id -> Plain id file. Keep this between runs so re-runs update.
# MAPPING_FILE=./zendesk-plain-mapping.json

# Set to 1 to print the plan and skip every Plain write. Same as --dry-run.
# DRY_RUN=1

# Optional JSON snapshot ({ "categories": [], "sections": [], "articles": [] })
# instead of calling Zendesk. Useful for a dry-run without credentials.
# ZENDESK_FIXTURE=./fixtures/help-center.json
